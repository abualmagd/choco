@layout('components/layout/app')


@section('content')

@if(products.length===0)
<div class=" text-2xl font-bold">No collections in this category yet </div>
@end

<div class=" grid lg:grid-cols-2 grid-cols-1 justify-center h-full w-full gap-6 ">
    @each(product in products)
    @!component('components/cubicCard', {
    id:product.id,
    slug:product.slug,
    cardImage:product.images?product.images[0]:'/public/assetes/images/holder.jpg',
    description:product.description??' ',
    price:product.price,
    currency:settings.currencyLogo
    })
    @end
</div>


@end