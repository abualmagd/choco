<div class=" flex flex-col gap-7  items-center   mt-20">
    <div class=" flex flex-col md:flex-row w-full justify-between ">
        <h2 class="text-2xl uppercase  font-bold">{{title||'Featured Products'}}</h2>
        <a href="{{link||'/products'}}" class=" underline ml-auto">view all</a>
    </div>

    <div
        class=" flex md:gap-4 gap-11 items-center  w-full  justify-between flex-col flex-wrap  md:flex-row flex-shrink-0 overflow-hidden ">
        @each((item,index) in featuredProducts)
        @if(index>4)

        @else
        @!component('components/cubicCard', {
        id:item.id,
        slug:item.slug,
        cardImage: item.images && item.images.length > 0 ? item.images[0].url : '/public/assetes/images/holder.jpg',
        description:item.description||item.name,
        price:item.price,
        currency:settings.currencyLogo
        })
        @end

        @end
    </div>


</div>